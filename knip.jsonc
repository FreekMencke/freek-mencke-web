{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    // `ng lint`'s builder in angular.json, installed by the angular-eslint package
    "@angular-eslint/builder",
  ],
  // Components load them through `styleUrl`, which knip's Angular plugin doesn't follow
  "ignoreFiles": ["src/**/*.component.css"],
}
