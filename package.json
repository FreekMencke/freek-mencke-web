    "node": ">=24"
  },
  "prettier": "./.prettierrc.json",
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.3",
    "@lucide/angular": "^1.59.0",
    "@ngrx/signals": "^22.0.1",
    "@osrs-tracker/express-metrics": "^0.1.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
